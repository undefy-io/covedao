# ─────────────────────────────────────────────────────────────
# Cove V3 — local development on regtest
# Copy to .env (gitignored). The web and worker read this repo-root file.
# The separate Guardian repository has its own local regtest command and
# production service variables. Non-secret settings (explorer, poll interval, ports, ord
# server) are committed in packages/config/src/cove-networks.ts; mainnet's
# profile is committed in packages/cove-mainnet/src/committed-profile.ts.
# Per-service deploy vars: apps/web/.env.example and apps/worker/.env.example.
# ─────────────────────────────────────────────────────────────

# Required, no default. Every service refuses to start without it.
COVE_NETWORK=regtest

# Sentry error monitoring. Set SENTRY_ENVIRONMENT=prod for the production build.
SENTRY_DSN=https://421068cb5bb534115c7743c304482d3a@o1206341.ingest.us.sentry.io/4512159121997824
SENTRY_ENVIRONMENT=dev

# Postgres for the V3 app, indexer and Guardian stores.
COVE_DATABASE_URL=postgres://cove:cove@127.0.0.1:5432/cove
# drizzle-kit (pnpm db:migrate) reads DATABASE_URL.
DATABASE_URL=postgres://cove:cove@127.0.0.1:5432/cove

# Local bitcoind -regtest. On regtest these default to
# http://127.0.0.1:18443 / user / pass when unset.
COVE_BITCOIN_RPC_URL=http://127.0.0.1:18443
COVE_BITCOIN_RPC_USER=user
COVE_BITCOIN_RPC_PASSWORD=pass

# Regtest signs in-process with the repo's PUBLIC test keys when these are
# unset (0x42… Guardian, 0x43… recovery, 0x44… fee). Never fund them.
# COVE_GUARDIAN_PRIVATE_KEY_HEX=
# COVE_RECOVERY_PRIVATE_KEY_HEX=
# COVE_FEE_PRIVATE_KEY_HEX=
# Where every protocol fee goes, as on mainnet (there: your bc1… address).
# This regtest address is a local-only key; `pnpm dev:fees` shows its balance.
# Unset, fees go to the fee key's address (0x44… on regtest). Changing it on a
# chain that already has tokens: `pnpm dev:infra:reset` and start again.
COVE_FEE_ADDRESS=bcrt1qp3xsenptjjlcks035l9gq7x0z5u5e2dum5kshy

# Built-in test wallet for the browser (regtest only; never in production).
COVE_DEV_WALLET=true

# Optional: raise the per-mint limit so the e2e suite can mint out a curve.
# COVE_REGTEST_MAX_MINT_GROSS_SATS=50000000

# Combined RPC attempt budget, including retries; use the same value on every service.
COVE_RPC_REQUESTS_PER_SECOND=3

# Trust a single client IP header only when your ingress overwrites it.
COVE_TRUSTED_CLIENT_IP_HEADER=none
