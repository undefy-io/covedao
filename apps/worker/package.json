{
  "name": "@crclaunch/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/crc.ts",
    "dev:v1": "tsx watch src/index.ts",
    "start": "tsx src/crc.ts",
    "start:crc": "tsx src/crc.ts",
    "dev:crc": "tsx watch src/crc.ts",
    "start:v1": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "reindex": "tsx src/reindex.ts",
    "demo:reset": "tsx src/demo-reset.ts",
    "test:integration": "tsx src/reorg.integration.ts",
    "v3": "tsx src/v3.ts"
  },
  "dependencies": {
    "@crclaunch/bitcoin": "workspace:*",
    "@crclaunch/config": "workspace:*",
    "@crclaunch/cove-app": "workspace:*",
    "@crclaunch/cove-guardian": "workspace:*",
    "@crclaunch/cove-indexer": "workspace:*",
    "@crclaunch/cove-mainnet": "workspace:*",
    "@crclaunch/curve": "workspace:*",
    "@crclaunch/db": "workspace:*",
    "@crclaunch/protocol": "workspace:*",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "envalid": "^8.2.0",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
