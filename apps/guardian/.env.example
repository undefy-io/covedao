# Cove Guardian service — deploy environment. Run it as its own service;
# the key below must exist nowhere else.

# regtest | signet | testnet | mainnet. Required, no default. The committed
# profile is a mainnet profile, so this must be mainnet in production.
COVE_NETWORK=mainnet

# Independent signer-side pause switch. Must be 1 to accept /sign on mainnet.
COVE_V3_CANARY_ACTIVE=0

# Postgres: the Guardian reads the index and keeps its signing journal and
# audit chain here.
COVE_DATABASE_URL=

# The Guardian's OWN view of the chain (API key in the URL for hosted
# providers). It refuses to sign a mint or redeem whose funding input is
# unconfirmed, and checks that against this node, not the web app.
# COVE_BITCOIN_RPC_USER / COVE_BITCOIN_RPC_PASSWORD are optional.
COVE_BITCOIN_RPC_URL=

# Bearer token the web app sends (its COVE_GUARDIAN_AUTH_TOKEN). Long and random.
GUARDIAN_AUTH_TOKEN=

# The Guardian's private key: exactly 64 hex characters. Required on mainnet.
# Its x-only public key must equal guardianXOnly in the committed profile, or
# the service refuses to start. The repo's test keys are refused.
GUARDIAN_KEY_HEX=

# Where every protocol fee (mint, redeem, marketplace) is paid: a bc1… address
# you control. Set it ONCE as a shared variable: web, worker and Guardian must
# all have the same value. It is part of the profile hash, so a service with a
# different address refuses to run. Required on mainnet.
COVE_FEE_ADDRESS=

# The service listens on port 4391 (committed). Railway private networking:
# the web reaches it at http://<this-service>.railway.internal:4391.
