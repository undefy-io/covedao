# Cove web (Next.js) — deploy environment. Exactly these variables; everything
# else is committed (packages/config/src/cove-networks.ts, and the mainnet
# profile in packages/cove-mainnet/src/committed-profile.ts).

# regtest | signet | testnet | mainnet. Required at build AND at runtime:
# the browser bundle is built for one network.
COVE_NETWORK=mainnet

# Keep legacy until CRC indexer, Guardian, API and wallet flows pass release gates.
# crc20 closes all /api/v3 routes before the CRC API is activated.
# Leave off until launch, buy and sell pass Guardian and regtest release gates.
COVE_CRC_TRADING_ACTIVE=0

# Sentry error monitoring. Use prod when building and running production.
SENTRY_DSN=https://421068cb5bb534115c7743c304482d3a@o1206341.ingest.us.sentry.io/4512159121997824
SENTRY_ENVIRONMENT=prod

# Mainnet writes remain disabled until the self-only canary is deliberately armed.
# Set to 1 for the canary; set to 0 and restart to pause new mutations.
COVE_V3_CANARY_ACTIVE=0

# Postgres shared with the worker (it writes the index; the web reads it).
COVE_DATABASE_URL=

# Bitcoin Core JSON-RPC. For Tatum, set COVE_BITCOIN_RPC_API_KEY instead of
# COVE_BITCOIN_RPC_USER / COVE_BITCOIN_RPC_PASSWORD; it is sent as x-api-key.
COVE_BITCOIN_RPC_URL=
# COVE_BITCOIN_RPC_API_KEY=

# The Guardian service. On Railway, the private URL is fine:
#   http://<guardian-service>.railway.internal:4391
# Otherwise it must be https://. Required on mainnet.
COVE_GUARDIAN_ENDPOINT=
# Same value as the Guardian's GUARDIAN_AUTH_TOKEN.
COVE_GUARDIAN_AUTH_TOKEN=

# Where every protocol fee (mint, redeem, marketplace) is paid: a bc1… address
# you control. Set it ONCE as a shared variable: web, worker and Guardian must
# all have the same value. It is part of the profile hash, so a service with a
# different address refuses to run. Required on mainnet.
COVE_FEE_ADDRESS=

# Never set COVE_GUARDIAN_PRIVATE_KEY_HEX, COVE_RECOVERY_PRIVATE_KEY_HEX or
# COVE_FEE_PRIVATE_KEY_HEX here: on mainnet the web refuses to start with them.

# Combined RPC attempt budget, including retries; use the same value on every service.
COVE_RPC_REQUESTS_PER_SECOND=3

# Trust a single client IP header only when your ingress overwrites it.
COVE_TRUSTED_CLIENT_IP_HEADER=none

# Public browser discovery/evidence endpoints, inlined at next build. Never include credentials.
NEXT_PUBLIC_COVE_BITCOIN_RPC_URL=
# Blockstream bases: mainnet https://blockstream.info/api,
# testnet https://blockstream.info/testnet/api, signet https://blockstream.info/signet/api.
NEXT_PUBLIC_COVE_ESPLORA_URL=
