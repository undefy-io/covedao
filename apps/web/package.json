{
  "name": "@crclaunch/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @crclaunch/docs build:web && next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "pnpm -w build:crc-runtime && playwright test",
    "test:e2e:crc": "pnpm -w build:crc-runtime && playwright test -c playwright.crc.config.ts",
    "test:e2e:crc-core": "pnpm -w build:crc-runtime && playwright test -c playwright.crc-core.config.ts",
    "test:e2e:crc-chain": "pnpm -w build:crc-runtime && playwright test -c playwright.crc-chain.config.ts"
  },
  "dependencies": {
    "@crclaunch/bitcoin": "workspace:*",
    "@crclaunch/config": "workspace:*",
    "@crclaunch/cove-app": "workspace:*",
    "@crclaunch/cove-covenant": "workspace:*",
    "@crclaunch/cove-economics": "workspace:*",
    "@crclaunch/cove-guardian": "workspace:*",
    "@crclaunch/cove-indexer": "workspace:*",
    "@crclaunch/cove-mainnet": "workspace:*",
    "@crclaunch/cove-market": "workspace:*",
    "@crclaunch/cove-vault": "workspace:*",
    "@crclaunch/cove-wire": "workspace:*",
    "@crclaunch/crc20-adapters": "workspace:*",
    "@crclaunch/crc20-protocol": "workspace:*",
    "@crclaunch/crc20-state": "workspace:*",
    "@crclaunch/curve": "workspace:*",
    "@crclaunch/db": "workspace:*",
    "@crclaunch/wallets": "workspace:*",
    "@ordzaar/ordit-sdk": "4.2.4",
    "@sentry/nextjs": "^11.0.0",
    "bitcoinjs-lib": "^6.1.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "ecpair": "^2.1.0",
    "envalid": "^8.2.0",
    "ioredis": "^5.4.2",
    "klinecharts": "^10.0.3",
    "next": "15.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tiny-secp256k1": "^2.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@crclaunch/crc20-guardian": "workspace:*",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
