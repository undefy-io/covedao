{
  "name": "crc-launch",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@crclaunch/web --filter=@crclaunch/worker",
    "dev:web": "turbo run dev --filter=@crclaunch/web",
    "dev:worker": "turbo run dev --filter=@crclaunch/worker",
    "dev:guardian": "turbo run dev --filter=@crclaunch/guardian",
    "dev:guardian:docker": "docker compose --profile guardian up -d --build --wait guardian",
    "dev:stack": "pnpm dev:infra && docker compose --profile guardian --profile app up -d --build --wait guardian worker web",
    "dev:infra": "docker compose up -d --wait && pnpm dev:db",
    "dev:infra:down": "docker compose --profile guardian --profile app down",
    "dev:infra:reset": "docker compose --profile guardian --profile app down -v",
    "dev:fees": "docker compose run --rm fees",
    "dev:db": "DATABASE_URL=postgres://cove:cove@127.0.0.1:5432/cove pnpm --filter @crclaunch/db exec drizzle-kit push --force",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=!@crclaunch/web --filter=!@crclaunch/worker",
    "test:e2e": "turbo run test:e2e",
    "test:garden-corpus": "python3 scripts/research/export-garden-compat-fixtures.py --check && python3 scripts/research/verify-garden-ledger-observations.py && pnpm --filter @crclaunch/crc20-transactions test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "db:generate": "pnpm --filter @crclaunch/db db:generate",
    "db:migrate": "pnpm --filter @crclaunch/db db:migrate",
    "db:push": "pnpm --filter @crclaunch/db db:push",
    "db:seed": "pnpm --filter @crclaunch/db db:seed",
    "reindex": "pnpm --filter @crclaunch/worker reindex",
    "demo:reset": "pnpm --filter @crclaunch/worker demo:reset",
    "cove:index": "pnpm --filter @crclaunch/cove-indexer index",
    "cove:verify": "pnpm --filter @crclaunch/cove-indexer verify",
    "cove:status": "pnpm --filter @crclaunch/cove-indexer status",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:integration": "pnpm --filter @crclaunch/worker test:integration",
    "cove:worker": "pnpm --filter @crclaunch/cove-indexer worker",
    "cove:signet-proof": "pnpm --filter @crclaunch/cove-indexer signet-proof",
    "cove:mutinynet-proof": "pnpm --filter @crclaunch/cove-indexer mutinynet-proof",
    "cove:mainnet-config": "pnpm --filter @crclaunch/cove-indexer mainnet-config",
    "cove:mainnet-canary": "pnpm --filter @crclaunch/cove-indexer mainnet-canary",
    "cove:regtest-reorg": "pnpm --filter @crclaunch/cove-indexer regtest-reorg",
    "cove:regtest-proof": "pnpm --filter @crclaunch/cove-guardian regtest-proof",
    "cove:v3-regtest-lifecycle": "pnpm --filter @crclaunch/cove-guardian v3-regtest-lifecycle",
    "cove:v3-mainnet-profile-lifecycle": "pnpm --filter @crclaunch/cove-guardian v3-mainnet-profile-lifecycle",
    "cove:csv-proof": "pnpm --filter @crclaunch/cove-vault csv-proof",
    "cove:ceremony-keys": "pnpm --filter @crclaunch/cove-vault ceremony-keys",
    "cove:v3-mainnet-readiness": "pnpm --filter @crclaunch/cove-app readiness",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:v3-architecture": "node scripts/check-v3-architecture.mjs",
    "cove:v3-release-manifest": "node scripts/cove-v3-release-manifest.mjs",
    "cove:v3-mutinynet-proof": "pnpm --filter @crclaunch/cove-guardian v3-mutinynet-proof",
    "cove:mempool-chain-proof": "node scripts/mempool-chain-proof.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "license": "MIT",
  "description": "A CRC-family token protocol on Bitcoin L1 \u2014 state-committed Taproot UTXOs, an open indexer, and a non-custodial marketplace.",
  "pnpm": {
    "overrides": {
      "bitcoinjs-lib": "6.1.8",
      "axios@>=1.0.0 <1.20.0": "^1.20.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.3",
      "postcss@<8.5.18": "^8.5.28"
    }
  }
}
